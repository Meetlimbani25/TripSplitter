# Copy these values into your local Tomcat/deployment environment.
# Do not rename this file to .env unless your runtime loads .env files.

# Aiven MySQL example:
DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/YOUR_DATABASE?sslMode=REQUIRED&allowPublicKeyRetrieval=true
DB_USER=avnadmin
DB_PASSWORD=YOUR_ROTATED_AIVEN_PASSWORD

# If Aiven requires a CA certificate, store it outside Git and add the option
# to DB_URL, for example:
# DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/YOUR_DATABASE?sslMode=VERIFY_CA&sslCa=E:/secure/aiven-ca.pem
