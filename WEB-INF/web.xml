<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1"
         metadata-complete="true">

    <display-name>TripSplitter - Smart Trip Expense Sharing System</display-name>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- Authentication Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/dashboard</url-pattern>
        <url-pattern>/createTrip</url-pattern>
        <url-pattern>/tripDetails</url-pattern>
        <url-pattern>/addExpense</url-pattern>
        <url-pattern>/expenses</url-pattern>
        <url-pattern>/balance</url-pattern>
        <url-pattern>/settle</url-pattern>
        <url-pattern>/joinTrip</url-pattern>
        <url-pattern>/deleteTrip</url-pattern>
        <url-pattern>/deleteExpense</url-pattern>
        <url-pattern>/exportPdf</url-pattern>
        <url-pattern>/exportExcel</url-pattern>
    </filter-mapping>

    <!-- Servlet Declarations -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>controller.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>controller.DashboardServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>CreateTripServlet</servlet-name>
        <servlet-class>controller.CreateTripServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>JoinTripServlet</servlet-name>
        <servlet-class>controller.JoinTripServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>TripDetailsServlet</servlet-name>
        <servlet-class>controller.TripDetailsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AddExpenseServlet</servlet-name>
        <servlet-class>controller.AddExpenseServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SettleServlet</servlet-name>
        <servlet-class>controller.SettleServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DeleteTripServlet</servlet-name>
        <servlet-class>controller.DeleteTripServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DeleteExpenseServlet</servlet-name>
        <servlet-class>controller.DeleteExpenseServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ExportPdfServlet</servlet-name>
        <servlet-class>controller.ExportPdfServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ExportExcelServlet</servlet-name>
        <servlet-class>controller.ExportExcelServlet</servlet-class>
    </servlet>

    <!-- Servlet Mappings -->
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CreateTripServlet</servlet-name>
        <url-pattern>/createTrip</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>JoinTripServlet</servlet-name>
        <url-pattern>/joinTrip</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TripDetailsServlet</servlet-name>
        <url-pattern>/tripDetails</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AddExpenseServlet</servlet-name>
        <url-pattern>/addExpense</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SettleServlet</servlet-name>
        <url-pattern>/settle</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DeleteTripServlet</servlet-name>
        <url-pattern>/deleteTrip</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DeleteExpenseServlet</servlet-name>
        <url-pattern>/deleteExpense</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ExportPdfServlet</servlet-name>
        <url-pattern>/exportPdf</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ExportExcelServlet</servlet-name>
        <url-pattern>/exportExcel</url-pattern>
    </servlet-mapping>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/login.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/login.jsp</location>
    </error-page>
</web-app>
